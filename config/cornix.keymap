#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        m_arrow: m_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };

        m_fat_arrow: m_fat_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
    };

    behaviors {
        arrows: arrows {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_arrow>, <&m_fat_arrow>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E     &kp R   &kp T                            &kp Y      &kp U   &kp I      &kp O     &kp P      &kp BSPC
&kp LCTRL  &kp A     &kp S     &kp D     &kp F   &kp G                            &kp H      &kp J   &kp K      &kp L     &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V   &kp B    &kp C_MUTE  &mkp MB3    &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT
&kp LCTRL  &kp LALT  &kp LALT  &kp LGUI  &mo 3   &kp ESC                          &kp SPACE  &mo 1   &mo 2      &kp LEFT  &kp LGUI   &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_encoder>;
        };

        nav_num_layer {
            display-name = "NavNum";
            bindings = <
&kp ESC  &kp N1     &kp N2  &kp N3    &kp N4    &kp N5                             &kp N6    &kp N7    &kp N8  &kp N9     &kp N0     &kp BSPC
&trans   &kp EQUAL  &trans  &trans    &kp SEMI  &kp MINUS                          &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp COLON  &kp ENTER
&trans   &trans     &trans  &trans    &trans    &trans     &kp C_MUTE  &mkp MB3    &trans    &trans    &trans  &trans     &trans     &trans
&trans   &trans     &trans  &kp LGUI  &mo 4     &trans                             &trans    &trans    &trans  &trans     &trans     &trans
            >;
        };

        symbol_layer {
            display-name = "Symbols";
            bindings = <
&trans  &kp GRAVE  &kp LT     &kp GT    &kp MINUS  &kp PIPE                           &kp CARET  &kp LBRC   &kp RBRC   &kp DLLR  &arrows  &trans
&trans  &kp EXCL   &kp ASTRK  &kp FSLH  &kp EQUAL  &kp AMPS                           &kp HASH   &kp LPAR   &kp RPAR   &kp SEMI  &kp DQT  &trans
&trans  &kp TILDE  &kp PLUS   &kp LBKT  &kp RBKT   &kp PRCNT  &kp C_MUTE  &mkp MB3    &kp AT     &kp COLON  &kp COMMA  &kp DOT   &kp SQT  &trans
&trans  &trans     &trans     &trans    &trans     &trans                             &trans     &trans     &trans     &trans    &trans   &trans
            >;
        };

        num_row_layer {
            display-name = "NumRow";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                           &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans                           &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE  &mkp MB3     &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                           &trans  &trans  &kp N0  &trans  &trans  &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &none        &none   &none  &none  &none  &none
&out OUT_TOG  &none         &none         &none         &none         &none                           &none        &none   &none  &none  &none  &none
&none         &none         &none         &none         &none         &bootloader   &none    &none    &bootloader  &none   &none  &none  &none  &none
&none         &none         &none         &none         &trans        &none                           &none        &trans  &none  &none  &none  &none
            >;
        };
    };
};


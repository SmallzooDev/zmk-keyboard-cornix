#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        m_arrow: m_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };

        m_fat_arrow: m_fat_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
    };

    behaviors {
        ak_semi: ak_semi {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp SEMI>;

            escape_colon {
                trigger-keys = <ESC>;
                max-prior-idle-ms = <300>;
                bindings = <&kp COLON>;
            };
        };

        arrows: arrows {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_arrow>, <&m_fat_arrow>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // BT_CLR is destructive (wipes the active profile's bonding), so it is
        // deliberately awkward: Adjust layer + both outer corners at once.
        combo_bt_clr {
            timeout-ms = <100>;
            key-positions = <0 11>;
            layers = <4>;
            bindings = <&bt BT_CLR>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // NavNum sits on the left thumb, Symbols on the right thumb, so Adjust
        // needs one thumb from each hand and the press order does not matter.
        adjust {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E     &kp R   &kp T                            &kp Y      &kp U   &kp I      &kp O     &kp P      &kp BSPC
&kp LCTRL  &kp A     &kp S     &kp D     &kp F   &kp G                            &kp H      &kp J   &kp K      &kp L     &ak_semi   &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V   &kp B    &kp C_MUTE  &mkp MB3    &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT
&kp LCTRL  &kp LALT  &kp LALT  &mo 3     &mo 1   &kp ESC                          &kp SPACE  &kp LGUI  &mo 2    &kp LEFT  &kp LGUI   &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_encoder>;
        };

        nav_num_layer {
            display-name = "NavNum";
            bindings = <
&kp F1  &kp F2  &kp F3   &kp F4   &kp F5   &kp F6                        &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &trans
&kp F7  &kp F8  &kp F9   &kp F10  &kp F11  &kp F12                       &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans  &trans  &trans   &trans   &trans   &trans   &trans     &trans    &trans    &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans   &trans   &trans   &trans                        &trans    &trans     &trans     &trans     &trans  &trans
            >;
        };

        symbol_layer {
            display-name = "Symbols";
            bindings = <
&trans  &kp GRAVE  &kp LT     &kp GT    &kp MINUS  &kp PIPE                           &kp CARET  &kp LBRC   &kp RBRC   &kp DLLR  &arrows  &trans
&trans  &kp EXCL   &kp ASTRK  &kp FSLH  &kp EQUAL  &kp AMPS                           &kp HASH   &kp LPAR   &kp RPAR   &kp SEMI  &kp DQT  &trans
&trans  &kp TILDE  &kp PLUS   &kp LBKT  &kp RBKT   &kp PRCNT  &kp C_MUTE  &mkp MB3    &kp AT     &kp COLON  &kp COMMA  &kp DOT   &kp SQT  &trans
&trans  &trans     &trans     &trans    &trans     &trans                             &trans     &trans     &trans     &trans    &trans   &trans
            >;
        };

        num_row_layer {
            display-name = "NumRow";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                           &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans                           &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE  &mkp MB3     &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                           &trans  &trans  &kp N0  &trans  &trans  &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&none         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &none        &none   &none  &none  &none  &none
&out OUT_TOG  &none         &none         &none         &none         &none                           &none        &none   &none  &none  &none  &none
&none         &none         &none         &none         &none         &bootloader   &none    &none    &bootloader  &none   &none  &none  &none  &none
&none         &none         &none         &trans        &trans        &none                           &none        &none   &trans &none  &none  &none
            >;
        };
    };
};

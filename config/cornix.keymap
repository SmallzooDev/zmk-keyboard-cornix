#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

/ {
    macros {
        m_arrow: m_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };

        m_fat_arrow: m_fat_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };

        tsym: tsym {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        ak_semi: ak_semi {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp SEMI>;

            escape_colon {
                trigger-keys = <ESC>;
                max-prior-idle-ms = <300>;
                bindings = <&kp COLON>;
            };
        };

        arrows: arrows {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_arrow>, <&m_fat_arrow>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bts_0: bts_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bts_1: bts_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bts_2: bts_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bts_3: bts_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bts_4: bts_4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 4>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        outs: outs {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&out OUT_TOG>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        lth: lth {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
        };

        hl: hl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hr_semi: hr_semi {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&ak_semi>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        // BT_CLR is destructive (wipes the active profile's bonding), so it is
        // deliberately awkward: Adjust layer + both outer corners at once.
        combo_bt_clr {
            timeout-ms = <100>;
            key-positions = <0 11>;
            layers = <4>;
            bindings = <&bt BT_CLR>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // NumRow(left outer thumb) + Symbols(right outer thumb): the symmetric
        // outer-thumb pair, and the press order does not matter.
        adjust {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E     &kp R   &kp T                            &kp Y      &kp U   &kp I      &kp O     &kp P      &kp BSPC
&kp LCTRL  &hl 3 A   &kp S     &kp D     &kp F   &kp G                            &kp H      &kp J   &kp K      &kp L     &hr_semi 3 0  &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V   &kp B    &kp C_MUTE  &mkp MB3    &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT
&kp LG(LALT)  &kp LG(LCTRL)  &kp LALT  &mo 3   &kp LGUI  &lth 2 ESC               &lth 2 SPACE  &mo 1  &mo 2    &none     &kp LG(LCTRL)  &kp LG(LSHFT)
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_encoder>;
        };

        nav_num_layer {
            display-name = "NavNum";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp F5                        &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &trans
&trans  &kp F6  &kp F7   &kp F8   &kp F9   &kp F10                       &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans  &kp F11  &kp F12  &trans  &trans   &trans   &trans     &trans    &trans    &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans   &trans   &trans   &trans                        &trans    &trans     &trans     &trans     &trans  &trans
            >;
        };

        symbol_layer {
            display-name = "Symbols";
            bindings = <
&trans  &tsym GRAVE  &tsym LT     &tsym GT     &tsym MINUS  &tsym PIPE                            &tsym CARET  &tsym LBKT  &tsym RBKT   &tsym DLLR  &arrows    &trans
&trans  &tsym EXCL   &tsym ASTRK  &tsym FSLH   &tsym KP_EQUAL  &tsym AMPS                         &tsym HASH   &tsym LBRC  &tsym RBRC   &tsym DQT   &tsym COLON  &trans
&trans  &tsym TILDE  &tsym PLUS   &tsym BSLH   &tsym UNDER  &tsym PRCNT  &kp C_MUTE  &mkp MB3     &tsym AT     &tsym LPAR  &tsym RPAR   &tsym SQT  &tsym QMARK  &trans
&trans  &trans     &trans     &trans    &trans     &trans                             &trans     &trans     &trans     &trans    &trans   &trans
            >;
        };

        num_row_layer {
            display-name = "NumRow";
            bindings = <
&trans  &kp N1       &kp N2       &kp N3      &kp N4          &kp N5                                &kp N6      &kp N7      &kp N8      &kp N9     &kp N0       &trans
&trans  &tsym EXCL   &tsym ASTRK  &tsym FSLH  &tsym KP_EQUAL  &tsym AMPS                            &tsym HASH  &tsym LBRC  &tsym RBRC  &tsym DQT  &tsym COLON  &trans
&trans  &tsym TILDE  &tsym PLUS   &tsym BSLH  &tsym UNDER     &tsym PRCNT  &kp C_MUTE  &mkp MB3     &tsym AT    &tsym LPAR  &trans      &trans     &tsym RPAR   &trans
&trans  &trans       &trans       &trans      &trans          &trans                                &trans      &kp N0      &trans      &trans     &trans       &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&none         &bts_0        &bts_1        &bts_2        &bts_3        &bts_4                          &none        &none   &none  &none  &none  &none
&outs         &none         &none         &none         &none         &none                           &none        &none   &none  &none  &none  &none
&trans        &none         &none         &none         &none         &none         &none    &none    &none        &none   &none  &none  &none  &trans
&none         &none         &none         &trans        &none         &none                           &none        &trans  &trans &none  &none  &none
            >;
        };
    };
};

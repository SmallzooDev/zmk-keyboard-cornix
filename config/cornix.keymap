#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define LAYER_NAV 1
#define LAYER_INTEGRATE 2
#define LAYER_ADJUST 3
#define LAYER_INT_LEFT 4
#define LAYER_INT_RIGHT 5
#define LAYER_NAV_CHORD 6

/ {
    macros {
        tsym: tsym {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        ak_semi: ak_semi {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp SEMI>;

            escape_colon {
                trigger-keys = <ESC>;
                max-prior-idle-ms = <300>;
                bindings = <&kp COLON>;
            };
        };

        // BT controls require BOTH shifts held (nested mod-morphs): the
        // outer morph checks left shift, the inner one checks right shift.
        bts_0: bts_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bts_0_r>;
            mods = <(MOD_LSFT)>;
        };

        bts_0_r: bts_0_r {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 0>;
            mods = <(MOD_RSFT)>;
        };

        bts_1: bts_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bts_1_r>;
            mods = <(MOD_LSFT)>;
        };

        bts_1_r: bts_1_r {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 1>;
            mods = <(MOD_RSFT)>;
        };

        bts_2: bts_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bts_2_r>;
            mods = <(MOD_LSFT)>;
        };

        bts_2_r: bts_2_r {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 2>;
            mods = <(MOD_RSFT)>;
        };

        bts_3: bts_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bts_3_r>;
            mods = <(MOD_LSFT)>;
        };

        bts_3_r: bts_3_r {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 3>;
            mods = <(MOD_RSFT)>;
        };

        bts_4: bts_4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bts_4_r>;
            mods = <(MOD_LSFT)>;
        };

        bts_4_r: bts_4_r {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_SEL 4>;
            mods = <(MOD_RSFT)>;
        };

        outs: outs {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&outs_r>;
            mods = <(MOD_LSFT)>;
        };

        outs_r: outs_r {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&out OUT_TOG>;
            mods = <(MOD_RSFT)>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

    };

    combos {
        compatible = "zmk,combos";

        // BT_CLR is destructive (wipes the active profile's bonding), so it is
        // deliberately awkward: Adjust layer + both outer corners at once.
        combo_bt_clr {
            timeout-ms = <200>;
            key-positions = <0 11>;
            layers = <LAYER_ADJUST>;
            bindings = <&bt BT_CLR>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        integrate_left {
            if-layers = <LAYER_INT_LEFT>;
            then-layer = <LAYER_INTEGRATE>;
        };

        integrate_right {
            if-layers = <LAYER_INT_RIGHT>;
            then-layer = <LAYER_INTEGRATE>;
        };

        nav_chord {
            if-layers = <LAYER_INT_LEFT LAYER_INT_RIGHT>;
            then-layer = <LAYER_NAV_CHORD>;
        };

        adjust {
            if-layers = <LAYER_NAV LAYER_INTEGRATE>;
            then-layer = <LAYER_ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E     &kp R   &kp T                            &kp Y      &kp U   &kp I      &kp O     &kp P      &kp BSPC
&kp LCTRL  &kp A     &kp S     &kp D     &kp F   &kp G                            &kp H      &kp J   &kp K      &kp L     &ak_semi   &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V   &kp B    &kp C_MUTE  &mkp MB3    &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT
&mo LAYER_NAV          &kp LG(LCTRL)  &kp LC(F)  &kp LGUI               &mo LAYER_INT_LEFT   &kp ESC                  &kp SPACE  &mo LAYER_INT_RIGHT  &kp LALT                 &kp LC(F)  &kp LG(LCTRL)  &mo LAYER_NAV
            >;
            sensor-bindings = <&inc_dec_kp LA(DOWN) LA(UP) &inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        nav_num_layer {
            display-name = "Nav";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp F5                        &kp HOME  &kp PG_DN        &kp PG_UP    &kp END    &trans  &trans
&trans  &kp F6  &kp F7   &kp F8   &kp F9   &kp F10                       &kp LEFT  &kp DOWN         &kp UP       &kp RIGHT  &trans  &trans
&trans  &kp F11  &kp F12  &trans  &trans   &trans   &trans     &trans    &trans    &kp LC(LS(TAB))  &kp LC(TAB)  &trans     &trans  &trans
&trans  &trans  &trans   &trans   &trans   &trans                        &kp TAB   &trans           &trans       &trans     &trans  &trans
            >;
        };

        num_sym_layer {
            display-name = "Integrate";
            bindings = <
&trans  &tsym N1     &tsym N2     &tsym N3    &tsym N4     &tsym N5                              &tsym N6    &tsym N7     &tsym N8    &tsym N9   &tsym N0     &trans
&trans  &tsym EQUAL  &tsym GRAVE  &tsym MINUS  &tsym BSLH  &tsym SQT                             &kp LEFT    &kp DOWN     &kp UP      &kp RIGHT  &tsym COLON  &trans
&trans  &tsym PLUS   &tsym EXCL   &tsym PRCNT  &tsym AMPS  &tsym LBKT  &kp C_MUTE  &mkp MB3      &tsym RBKT  &tsym ASTRK  &trans      &trans     &trans        &trans
&trans  &trans       &trans       &trans      &trans       &trans                                &trans      &trans       &trans      &trans     &trans       &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&none   &bts_0  &bts_1  &bts_2  &bts_3  &bts_4                    &none  &none   &none  &outs  &none  &none
&none   &none   &none   &none   &none   &none                     &none  &none   &none  &none  &none  &none
&trans  &none   &none   &none   &none   &none   &none    &none    &none  &none   &none  &none  &none  &trans
&none   &none   &none   &trans  &trans  &none                     &none  &trans  &trans &none  &none  &none
            >;
        };

        int_left_layer {
            display-name = "IntLeft";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        int_right_layer {
            display-name = "IntRight";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav_chord_layer {
            display-name = "NavChord";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp F5                        &kp HOME  &kp PG_DN        &kp PG_UP    &kp END    &trans  &trans
&trans  &kp F6  &kp F7   &kp F8   &kp F9   &kp F10                       &kp LEFT  &kp DOWN         &kp UP       &kp RIGHT  &trans  &trans
&trans  &kp F11  &kp F12  &trans  &trans   &trans   &trans     &trans    &trans    &kp LC(LS(TAB))  &kp LC(TAB)  &trans     &trans  &trans
&trans  &trans  &trans   &trans   &trans   &trans                        &kp TAB   &trans           &trans       &trans     &trans  &trans
            >;
        };
    };
};
